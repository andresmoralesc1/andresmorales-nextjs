# --- Brevo (transactional email API) ---------------------------------------
# Source: ux-ai-emailer account (single Brevo account covers both projects)
BREVO_API_KEY=your_brevo_api_key_here

# Where briefs land. Use info@ (forwards to Gmail) instead of andres@
# so Brevo doesn't flag the send as a same-domain loop.
BRIEF_TO_EMAIL=info@andresmorales.com.co

# Who they appear to come from (display name shown in Gmail)
# Sender andres@andresmorales.com.co must be verified in Brevo
BRIEF_FROM_EMAIL=andres@andresmorales.com.co
BRIEF_FROM_NAME=Andrés Morales

# --- ClickUp integration ---------------------------------------------------
# Every brief also creates a task here so it lands in the pipeline board
# alongside your other work.
# Token: ClickUp → Settings → Apps → API
CLICKUP_API_TOKEN=pk_your_clickup_token_here
# List ID of the "New -- awaiting review" list (see README for setup)
CLICKUP_BRIEF_LIST_ID=900000000000

# --- Analytics (optional) --------------------------------------------------
# Umami — self-hosted, cookieless, GDPR-friendly analytics. The Caddy vhost
# for umami.andresmorales.com.co proxies to the Umami container (see
# /home/telchar/umami/docker-compose.yml). To enable:
#   1. Open the Umami dashboard at https://umami.andresmorales.com.co
#   2. Settings → Websites → Add website (or copy the id of an existing one)
#   3. Paste the website-id (UUID) below. When unset, the Umami <script>
#      tag is omitted from the page and events flow only to the in-app
#      CustomEvent dispatcher + console.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# --- Google Search Console verification -----------------------------------
# After verifying andresmorales.com.co at
# https://search.google.com/search-console/ (URL-prefix or Domain method),
# GSC gives you a meta tag value like "abc123xyz...". Paste it below.
# Leave empty until verified; the meta tag will be omitted from <head>.
# This is the single highest-ROI SEO setup step: without it you have no
# visibility into what Google indexes, what queries you rank for, or
# what crawl errors you have.
NEXT_PUBLIC_GSC_VERIFICATION=

# --- Google Analytics 4 (optional, opt-in) ---------------------------------
# GA4 Measurement ID in the form G-XXXXXXXXXX. Set this to enable gtag.js
# on every page. The site defaults analytics_storage to 'denied' until the
# user accepts cookies (consent mode v2), so the tag is GDPR-friendly out
# of the box. When unset, no gtag.js is loaded — useful if you only want
# Umami and no GA at all.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

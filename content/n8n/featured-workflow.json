 Array.isArray(rawInput) ? rawInput[0] : rawInput;\nconst event = eventData.data || eventData;\nconst now = new Date().toISOString();\n\nconst safeGet = (obj, path, defaultValue = '') => {\n  const keys = path.split('.');\n  let result = obj;\n  for (const key of keys) {\n    if (result && typeof result === 'object') {\n      result = result[key];\n    } else {\n      return defaultValue;\n    }\n  }\n  return result !== undefined && result !== null ? result : defaultValue;\n};\n\nconst safeDate = (dateStr) => {\n  if (!dateStr) return null;\n  const d = new Date(dateStr);\n  return isNaN(d.getTime()) ? null : d.toISOString();\n};\n\nconst artistName = event.artists && event.artists.length > 0 ? event.artists.map(a => a.name).join(', ') : 'Various Artists';\nconst artistImage = event.artists && event.artists.length > 0 ? event.artists[0].image_url || '' : '';\nconst musicGenres = event.music_genres && event.music_genres.length > 0 ? event.music_genres.join(', ') : 'N/A';\n\nconst eventDate = event.start_date ? new Date(event.start_date).toLocaleDateString('es-ES', {\n  weekday: 'long',\n  year: 'numeric',\n  month: 'long',\n  day: 'numeric'\n}) : '';\n\nconst tickets = event.ticket_rates || [];\n\nlet minPrice = null;\nlet maxPrice = null;\nlet totalAvailable = 0;\n\ntickets.forEach(ticket => {\n  const price = safeGet(ticket, 'current_price.price') || 0;\n  if (price > 0) {\n    if (minPrice === null || price < minPrice) minPrice = price;\n    if (maxPrice === null || price > maxPrice) maxPrice = price;\n  }\n  totalAvailable += safeGet(ticket, 'availability.available', 0);\n});\n\nconst result = {\n  event_id: event.id || event._id,\n  name: event.name || '',\n  code: event.code || '',\n  date_formatted: eventDate,\n  start_date: safeDate(event.start_date),\n  image_url: event.image_url || '',\n  artist_name: artistName,\n  artist_image_url: artistImage,\n  music_genres: musicGenres,\n  description: event.description || '',\n  purchase_url: safeGet(event, 'iframe.tag_url') || '',\n  venue_name: safeGet(event, 'location.name') || '',\n  venue_city: safeGet(event, 'location.city') || '',\n  tickets_count: tickets.length,\n  min_price: minPrice || 0,\n  max_price: maxPrice || 0,\n  total_available: totalAvailable,\n  updated_at: now\n};\n\nfor (let i = 0; i < 20; i++) {\n  const ticket = tickets[i];\n  const suffix = i + 1;\n  if (ticket) {\n    result[`ticket_${suffix}_id`] = ticket._id || '';\n    result[`ticket_${suffix}_name`] = ticket.name || '';\n    result[`ticket_${suffix}_price`] = safeGet(ticket, 'current_price.price') || safeGet(ticket, 'prices.0.price') || 0;\n    result[`ticket_${suffix}_includes`] = safeGet(ticket, 'current_price.includes') || safeGet(ticket, 'prices.0.includes') || '';\n    result[`ticket_${suffix}_sold`] = safeGet(ticket, 'availability.sold', 0);\n    result[`ticket_${suffix}_available`] = safeGet(ticket, 'availability.available', 0);\n    result[`ticket_${suffix}_min`] = ticket.min || 1;\n    result[`ticket_${suffix}_max`] = ticket.max || 5;\n  } else {\n    result[`ticket_${suffix}_id`] = '';\n    result[`ticket_${suffix}_name`] = '';\n    result[`ticket_${suffix}_price`] = 0;\n    result[`ticket_${suffix}_includes`] = '';\n    result[`ticket_${suffix}_sold`] = 0;\n    result[`ticket_${suffix}_available`] = 0;\n    result[`ticket_${suffix}_min`] = 0;\n    result[`ticket_${suffix}_max`] = 0;\n  }\n}\n\nreturn { json: result };"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1440,16],"id":"a7e2d660-911f-42d5-bd30-10e2779d2610","name":"Format Events"},{"parameters":{"operation":"upsert","dataTableId":{"__rl":true,"value":"D0H6NQeXe8h9L7Ra","mode":"id"},"filters":{"conditions":[{"keyName":"event_id","keyValue":"={{ $json.event_id }}"}]},"columns":{"mappingMode":"autoMapInputData","value":{},"matchingColumns":[],"schema":[{"id":"event_id","displayName":"event_id","required":false,"defaultMatch":false,"display":true,"type":"string","readOnly":false,"removed":false},{"id":"name","displayNa